<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FDG</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="BuiltInAssets\SillyManModel.obj" />
    <None Remove="BuiltInAssets\SillyManTexture.png" />
    <None Remove="BuiltInAssets\StrategistLeafV1.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuiltInAssets\SillyManModel.obj" />
    <EmbeddedResource Include="BuiltInAssets\SillyManTexture.png" />
    <!-- #191 step 15b: the Strategist's shipped leaf evaluator. Embedded rather than copied beside
         the binary so it cannot go missing from any of the four unsigned platform archives. -->
    <EmbeddedResource Include="BuiltInAssets\StrategistLeafV1.json" />
  </ItemGroup>

  <!-- RETIRED (work item 071, formerly numbered 052): the TempVisual system is superseded by the
       presentation-beat stream (FDG.Presentation). Kept on disk for reference but excluded from
       compilation. See TempVisuals/_RETIRED.md. -->
  <ItemGroup>
    <Compile Remove="TempVisuals/**/*.cs" />
    <None Include="TempVisuals/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0" />
    <PackageReference Include="System.Reactive" Version="6.0.2" />
  </ItemGroup>

</Project>
